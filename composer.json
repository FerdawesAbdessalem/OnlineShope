{
    "name": "ferdaoues/mf-buy",
    "description": "M&F Buy — online store for network equipment (PHP 8, MySQL, no framework).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" },
        "files": ["src/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public",
        "setup": "php bin/setup.php",
        "test": "phpunit"
    }
}
